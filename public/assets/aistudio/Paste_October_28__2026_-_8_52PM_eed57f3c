    function evaluateCurrentTestOnExit() {
      // Called when user transitions out of a test to ensure honest evaluation
      const current = STATE.activeTestName;

      if (current === 'grid') {
        if (STATE.gridCoveredPercent >= 95) {
          STATE.results.grid = { status: 'pass', detail: `${STATE.gridCoveredPercent}% aktív felület lefedve` };
        } else if (STATE.gridCoveredPercent > 0) {
          STATE.results.grid = { status: 'fail', detail: `Nem teljes: csak ${STATE.gridCoveredPercent}% lefedve` };
        } else {
          STATE.results.grid = { status: 'skipped', detail: 'Kihagyva: 0% lefedettség' };
        }
      } else if (current === 'multitouch') {
        if (STATE.maxTouchDetected >= 5) {
          STATE.results.multitouch = { status: 'pass', detail: `${STATE.maxTouchDetected} egyidejű érintési pont észlelve` };
        } else if (STATE.maxTouchDetected >= 2) {
          STATE.results.multitouch = { status: 'pass', detail: `${STATE.maxTouchDetected} pont szimultán követve` };
        } else if (STATE.maxTouchDetected === 1) {
          STATE.results.multitouch = { status: 'fail', detail: 'Csak 1 érintési pont érzékelve' };
        } else {
          STATE.results.multitouch = { status: 'skipped', detail: 'Kihagyva: 0 érintési pont' };
        }
      } else if (current === 'bubbles') {
        if (STATE.targetsHitCount >= 10) {
          STATE.results.bubbles = { status: 'pass', detail: `${STATE.targetsHitCount}/15 célpont (${STATE.avgLatencyMs} ms késleltetés)` };
        } else if (STATE.targetsHitCount > 0) {
          STATE.results.bubbles = { status: 'fail', detail: `Nem teljes: csak ${STATE.targetsHitCount}/15 célpont (${STATE.avgLatencyMs} ms)` };
        } else {
          STATE.results.bubbles = { status: 'skipped', detail: 'Kihagyva: 0 célpont megérintve' };
        }
      } else if (current === 'pixel') {
        if (STATE.results.pixel.status === 'pending') {
          STATE.results.pixel = { status: 'skipped', detail: 'A vizsgálat befejezése előtt továbbhaladva' };
        }
      } else if (current === 'geometry') {
        if (STATE.results.geometry.status === 'pending') {
          STATE.results.geometry = { status: 'skipped', detail: 'A vizsgálat befejezése előtt továbbhaladva' };
        }
      }
    }

