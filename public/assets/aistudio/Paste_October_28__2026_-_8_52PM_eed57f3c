      } else if (STATE.currentScreen === 'screen-geometry') {
        if (!document.getElementById('eval-geometry').classList.contains('active')) {
          if (key === ' ' || key === 'g' || key === 'G') {
            geomMode = geomMode === 0 ? 1 : 0;
            drawGeometry();
            e.preventDefault();
          } else if (key === 'Enter') {
            showGeometryEvaluation();
            e.preventDefault();
          }
