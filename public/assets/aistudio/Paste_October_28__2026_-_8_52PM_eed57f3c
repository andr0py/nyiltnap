    /* ========================================================================
       7. SILENT KEYBOARD NAVIGATION (FOR TESTING AT HOME)
       ======================================================================== */
    window.addEventListener('keydown', (e) => {
      const key = e.key;

      if (key === 'm' || key === 'M') {
        toggleSound();
        e.preventDefault();
        return;
      }

      if (key === 'f' || key === 'F') {
        toggleFullscreen();
        e.preventDefault();
        return;
      }

      if (key === 'Escape' || key === 'h' || key === 'H') {
        goHome();
        e.preventDefault();
        return;
      }

      if (STATE.activeTestName) {
        const briefingEl = document.getElementById(`briefing-${STATE.activeTestName}`);
        if (briefingEl && !briefingEl.classList.contains('hidden')) {
          if (key === ' ' || key === 'Enter') {
            startActiveTest(STATE.activeTestName);
            e.preventDefault();
            return;
          }
        }
      }

      const numMap = {
        '1': 'screen-pixel',
        '2': 'screen-grid',
        '3': 'screen-multitouch',
        '4': 'screen-bubbles',
        '5': 'screen-geometry',
        '6': 'screen-certificate'
      };
      if (numMap[key]) {
        evaluateCurrentTestOnExit();
        sound.playClick();
        STATE.isGuidedMode = true;
        showScreen(numMap[key]);
        e.preventDefault();
        return;
      }

      if (STATE.currentScreen === 'screen-welcome') {
        if (key === ' ' || key === 'Enter') {
          sound.playClick();
          STATE.isGuidedMode = true;
          showScreen('screen-pixel');
          e.preventDefault();
        }
      } else if (STATE.currentScreen === 'screen-pixel') {
        if (!document.getElementById('eval-pixel').classList.contains('active')) {
          if (key === ' ' || key === 'ArrowRight' || key === 'Enter') {
            stepPixelPattern(1);
            e.preventDefault();
          } else if (key === 'ArrowLeft') {
            stepPixelPattern(-1);
            e.preventDefault();
          }
        }
      } else if (STATE.currentScreen === 'screen-grid') {
        if (key === 'a' || key === 'A') {
          autofillGrid();
          e.preventDefault();
        } else if (key === 'r' || key === 'R') {
          initGridScreen();
          e.preventDefault();
        } else if (key === ' ' || key === 'Enter') {
          advanceGuided();
          e.preventDefault();
        }
      } else if (STATE.currentScreen === 'screen-multitouch') {
        if (key === 'r' || key === 'R') {
          clearCanvas();
          e.preventDefault();
        } else if (key === '0') {
          simulateTouches(10);
          e.preventDefault();
        } else if (key === '5') {
          simulateTouches(5);
          e.preventDefault();
        } else if (key === '2') {
          simulateTouches(2);
          e.preventDefault();
        } else if (key === ' ' || key === 'Enter') {
          advanceGuided();
          e.preventDefault();
