    /* ========================================================================
       9. MODULE 1: PIXEL INTEGRITY (CURSOR: NONE • 100% PURE FULLSCREEN)
       ======================================================================== */
    let pixelCanvas, pixelCtx;
    let currentPatternIdx = 0;

    const patterns = [
      { type: 'solid', color: '#000000' },
      { type: 'solid', color: '#ffffff' },
      { type: 'solid', color: '#ff0000' },
      { type: 'solid', color: '#00ff00' },
      { type: 'solid', color: '#0000ff' },
      { type: 'solid', color: '#808080' },
      { type: 'colorbars' },
      { type: 'checkerboard' },
      { type: 'gradient_gray' },
      { type: 'gradient_rgb' }
    ];

    function initPixelScreen() {
      pixelCanvas = document.getElementById('pixel-canvas');
      pixelCtx = pixelCanvas.getContext('2d');
      resizeCanvas(pixelCanvas);
      currentPatternIdx = 0;
      document.getElementById('eval-pixel').classList.remove('active');
      drawPixelPattern();
    }

    function drawPixelPattern() {
      const w = pixelCanvas.width;
      const h = pixelCanvas.height;
      const p = patterns[currentPatternIdx];

      if (p.type === 'solid') {
        pixelCtx.fillStyle = p.color;
        pixelCtx.fillRect(0, 0, w, h);
      } else if (p.type === 'colorbars') {
        const barColors = ['#ffffff', '#ffff00', '#00ffff', '#00ff00', '#ff00ff', '#ff0000', '#0000ff', '#000000'];
        const barW = w / barColors.length;
        barColors.forEach((c, i) => {
          pixelCtx.fillStyle = c;
          pixelCtx.fillRect(Math.round(i * barW), 0, Math.ceil(barW), h);
        });
      } else if (p.type === 'checkerboard') {
        const size = 60;
        for (let y = 0; y < h; y += size) {
          for (let x = 0; x < w; x += size) {
            const isBlack = (Math.floor(x / size) + Math.floor(y / size)) % 2 === 0;
            pixelCtx.fillStyle = isBlack ? '#000000' : '#ffffff';
            pixelCtx.fillRect(x, y, size, size);
          }
        }
      } else if (p.type === 'gradient_gray') {
        const grad = pixelCtx.createLinearGradient(0, 0, w, 0);
        grad.addColorStop(0, '#000000');
        grad.addColorStop(1, '#ffffff');
        pixelCtx.fillStyle = grad;
        pixelCtx.fillRect(0, 0, w, h);
      } else if (p.type === 'gradient_rgb') {
        const bandH = h / 3;
        const gR = pixelCtx.createLinearGradient(0, 0, w, 0);
        gR.addColorStop(0, '#000000'); gR.addColorStop(1, '#ff0000');
        pixelCtx.fillStyle = gR; pixelCtx.fillRect(0, 0, w, bandH);

        const gG = pixelCtx.createLinearGradient(0, 0, w, 0);
        gG.addColorStop(0, '#000000'); gG.addColorStop(1, '#00ff00');
        pixelCtx.fillStyle = gG; pixelCtx.fillRect(0, bandH, w, bandH);

        const gB = pixelCtx.createLinearGradient(0, 0, w, 0);
        gB.addColorStop(0, '#000000'); gB.addColorStop(1, '#0000ff');
        pixelCtx.fillStyle = gB; pixelCtx.fillRect(0, bandH * 2, w, bandH);
      }
    }

    function stepPixelPattern(dir) {
      sound.playClick();
      currentPatternIdx += dir;

      if (currentPatternIdx >= patterns.length) {
        showPixelEvaluation();
      } else if (currentPatternIdx < 0) {
        currentPatternIdx = 0;
        drawPixelPattern();
      } else {
        drawPixelPattern();
      }
    }

    function showPixelEvaluation() {
      document.getElementById('eval-pixel').classList.add('active');
    }

    document.getElementById('pixel-canvas').addEventListener('pointerdown', () => {
      if (!document.getElementById('eval-pixel').classList.contains('active')) {
        stepPixelPattern(1);
      }
    });

    document.getElementById('pixel-canvas').addEventListener('wheel', (e) => {
      e.preventDefault();
      if (!document.getElementById('eval-pixel').classList.contains('active')) {
        stepPixelPattern(e.deltaY > 0 ? 1 : -1);
      }
    }, { passive: false });

    document.getElementById('btn-eval-pixel-pass').addEventListener('click', () => {
