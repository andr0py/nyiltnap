    /* ========================================================================
       10. MODULE 2: DIGITIZER MATRIX GRID COVERAGE (AUTOMATIC PASS/FAIL)
       ======================================================================== */
    let gridTotal = 0;
    let gridFilled = 0;
    let isGridPointerDown = false;

    function initGridScreen() {
      const container = document.getElementById('grid-matrix');
      container.innerHTML = '';

      const cols = 14;
      const rows = 9;
      gridTotal = cols * rows;
      gridFilled = 0;

      container.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
      container.style.gridTemplateRows = `repeat(${rows}, 1fr)`;

      for (let i = 0; i < gridTotal; i++) {
        const cell = document.createElement('div');
        cell.className = 'matrix-cell';
        cell.dataset.index = i;

        cell.addEventListener('mouseenter', () => {
          if (isGridPointerDown) fillCell(cell);
        });

        cell.addEventListener('mousedown', () => {
          fillCell(cell);
        });

        container.appendChild(cell);
      }

      updateGridUI();

      function fillCell(cell) {
        if (cell && !cell.classList.contains('active')) {
          cell.classList.add('active');
          gridFilled++;
          sound.playGridTone(gridFilled, gridTotal);
          updateGridUI();

          if (gridFilled === gridTotal) {
            sound.playFanfare();
            STATE.gridCoveredPercent = 100;
            STATE.results.grid = { status: 'pass', detail: '100% lefedettség (Minden zóna aktív)' };
            // Auto-advance after short fanfare delay
            setTimeout(() => advanceGuided(), 900);
          }
        }
      }

      function handleAt(clientX, clientY) {
        const target = document.elementFromPoint(clientX, clientY);
        if (target && target.classList.contains('matrix-cell')) fillCell(target);
      }

      container.onpointerdown = (e) => {
        isGridPointerDown = true;
        handleAt(e.clientX, e.clientY);
      };

      window.addEventListener('pointerup', () => {
        isGridPointerDown = false;
      });

      container.onpointermove = (e) => {
        if (isGridPointerDown || e.pointerType === 'touch') {
          handleAt(e.clientX, e.clientY);
        }
      };

      container.ontouchmove = (e) => {
        for (let i = 0; i < e.touches.length; i++) {
          handleAt(e.touches[i].clientX, e.touches[i].clientY);
        }
      };
    }

    function autofillGrid() {
      const cells = document.querySelectorAll('.matrix-cell:not(.active)');
      if (!cells.length) return;
      let i = 0;
      const intv = setInterval(() => {
        if (i < cells.length) {
          cells[i].classList.add('active');
          gridFilled++;
          sound.playGridTone(gridFilled, gridTotal);
          updateGridUI();
          i++;
        } else {
          clearInterval(intv);
          sound.playFanfare();
          STATE.gridCoveredPercent = 100;
          STATE.results.grid = { status: 'pass', detail: '100% lefedettség (Minden zóna aktív)' };
          setTimeout(() => advanceGuided(), 900);
        }
      }, 8);
    }

    function updateGridUI() {
      const pct = Math.round((gridFilled / gridTotal) * 100);
      document.getElementById('grid-hud-pct').innerText = `${pct}%`;
      STATE.gridCoveredPercent = pct;
    }

    document.getElementById('btn-grid-reset-hud').addEventListener('click', (e) => {
      e.stopPropagation();
      sound.playClick();
      initGridScreen();
    });

    document.getElementById('btn-grid-done-hud').addEventListener('click', (e) => {
      e.stopPropagation();
      sound.playClick();
      advanceGuided();
    });

    /* ========================================================================
       11. MODULE 3: MULTI-TOUCH DIGITIZER TRACKER (AUTOMATIC PASS/FAIL)
       ======================================================================== */
    let mtCanvas, mtCtx;
    const trackerColors = ['#0076ce', '#16a34a', '#d97706', '#dc2626', '#9333ea', '#0284c7', '#22c55e', '#f59e0b', '#db2777', '#2563eb'];
    let touchHistory = {};
    let staticPins = [];

    function initMultitouchScreen() {
      mtCanvas = document.getElementById('multitouch-canvas');
      mtCtx = mtCanvas.getContext('2d');
      resizeCanvas(mtCanvas);
      clearCanvas();
    }

    function clearCanvas() {
      if (!mtCtx) return;
      mtCtx.fillStyle = '#ffffff';
      mtCtx.fillRect(0, 0, mtCanvas.width, mtCanvas.height);
      touchHistory = {};
      staticPins = [];
      document.getElementById('mt-hud-count').innerText = '0';
    }

    function simulateTouches(count) {
      if (!mtCtx) return;
      STATE.maxTouchDetected = Math.max(STATE.maxTouchDetected, count);
      document.getElementById('mt-hud-count').innerText = `${count}`;
      sound.playChord(count);

      const w = mtCanvas.width;
      const h = mtCanvas.height;

      for (let i = 0; i < count; i++) {
        let x, y;
        if (count <= 5) {
          x = (w * 0.25) + (i * (w * 0.5 / Math.max(count - 1, 1)));
          y = h * 0.5 + Math.sin(i) * 60;
        } else {
          const hand = i < 5 ? 0 : 1;
          const f = i % 5;
          x = (hand === 0 ? w * 0.2 : w * 0.6) + (f * (w * 0.2 / 4));
          y = h * 0.5 + Math.sin(f) * 60;
        }

        const color = trackerColors[i % trackerColors.length];

        mtCtx.strokeStyle = color;
        mtCtx.lineWidth = 2;
        mtCtx.beginPath();
        mtCtx.arc(x, y, 36, 0, Math.PI * 2);
        mtCtx.stroke();

        mtCtx.beginPath();
        mtCtx.arc(x, y, 8, 0, Math.PI * 2);
        mtCtx.fillStyle = color;
        mtCtx.fill();

        mtCtx.beginPath();
        mtCtx.moveTo(x - 45, y); mtCtx.lineTo(x + 45, y);
        mtCtx.moveTo(x, y - 45); mtCtx.lineTo(x, y + 45);
        mtCtx.stroke();

        mtCtx.fillStyle = '#0f172a';
        mtCtx.font = 'bold 11px "SF Mono", Consolas, monospace';
        mtCtx.fillText(`TP#${i+1} [${Math.round(x)},${Math.round(y)}]`, x + 18, y - 18);
      }
    }

    document.getElementById('btn-mt-clear-hud').addEventListener('click', (e) => {
      e.stopPropagation();
      sound.playClick();
      clearCanvas();
    });

    document.getElementById('btn-mt-done-hud').addEventListener('click', (e) => {
      e.stopPropagation();
      sound.playClick();
      advanceGuided();
    });

    const mtViewport = document.querySelector('.multitouch-viewport');

    function handleTouches(e) {
      e.preventDefault();
      const rect = mtCanvas.getBoundingClientRect();
      const touches = e.touches || [];
      const count = touches.length;

      document.getElementById('mt-hud-count').innerText = `${count}`;
      if (count > STATE.maxTouchDetected) STATE.maxTouchDetected = count;
      if (count > 0) sound.playChord(count);

      for (let i = 0; i < touches.length; i++) {
        const t = touches[i];
        const x = t.clientX - rect.left;
        const y = t.clientY - rect.top;
        const color = trackerColors[i % trackerColors.length];
        const id = t.identifier;

        if (touchHistory[id]) {
          mtCtx.beginPath();
          mtCtx.moveTo(touchHistory[id].x, touchHistory[id].y);
          mtCtx.lineTo(x, y);
          mtCtx.strokeStyle = color;
          mtCtx.lineWidth = 6;
          mtCtx.lineCap = 'round';
          mtCtx.stroke();
        }
        touchHistory[id] = { x, y };
      }
    }

    mtViewport.addEventListener('touchstart', handleTouches, { passive: false });
    mtViewport.addEventListener('touchmove', handleTouches, { passive: false });
    mtViewport.addEventListener('touchend', (e) => {
      const active = Array.from(e.touches).map(t => t.identifier);
      Object.keys(touchHistory).forEach(id => {
        if (!active.includes(Number(id))) delete touchHistory[id];
      });
      document.getElementById('mt-hud-count').innerText = `${e.touches.length}`;
    }, { passive: false });


    /* ========================================================================
       12. MODULE 4: TARGET ACQUISITION & RESPONSE LATENCY (AUTOMATIC PASS/FAIL)
       ======================================================================== */
    let targetCanvas, targetCtx;
    let targets = [];
    let shockwaves = [];
    let scorePops = [];
    let targetsHit = 0;
    const TOTAL_TARGETS = 15;
    let targetAnimFrame = null;
    let lastSpawn = 0;

    class TargetObject {
      constructor(w, h, startY = null) {
        this.radius = 38 + Math.random() * 18;
        const pad = this.radius + 24;
        this.x = pad + Math.random() * Math.max(w - pad * 2, 80);
        this.y = startY !== null ? startY : h + this.radius + 15;
        this.vx = (Math.random() - 0.5) * 1.6;
        this.vy = -(1.2 + Math.random() * 1.6);
        this.color = trackerColors[Math.floor(Math.random() * trackerColors.length)];
        this.spawnTime = performance.now();
        this.pulse = Math.random() * Math.PI * 2;
      }

      update(w) {
        this.x += this.vx;
        this.y += this.vy;
        this.pulse += 0.05;

        // Keep targets within horizontal bounds with gentle bounce
        const pad = this.radius + 12;
        if (this.x < pad) {
          this.x = pad;
          this.vx = Math.abs(this.vx);
        } else if (this.x > w - pad) {
          this.x = w - pad;
          this.vx = -Math.abs(this.vx);
        }
      }

      draw(ctx) {
        ctx.save();

        // 1. Soft tinted glass background fill (inviting tactile touch feel)
        ctx.fillStyle = this.color;
        ctx.globalAlpha = 0.08;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fill();

        // 2. High-precision outer circular reticle
        ctx.globalAlpha = 0.85;
        ctx.strokeStyle = this.color;
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.stroke();

        // 3. Subtle optic reflection highlight arc (clean glass surface)
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius - 4, -Math.PI * 0.8, -Math.PI * 0.4);
        ctx.stroke();

        // 4. Concentric inner reticle ring (smooth pulsing radar effect)
        const innerR = Math.max(12, this.radius * 0.42 + Math.sin(this.pulse) * 3);
        ctx.strokeStyle = this.color;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(this.x, this.y, innerR, 0, Math.PI * 2);
        ctx.stroke();

        // 5. Solid center bullseye dot
        ctx.fillStyle = this.color;
        ctx.beginPath();
        ctx.arc(this.x, this.y, 4, 0, Math.PI * 2);
        ctx.fill();

        // 6. True 4-way optical crosshair lines (horizontal and vertical, cleanly aligned)
        const gap = innerR + 4;
        const ext = this.radius + 10;
        ctx.lineWidth = 2;
        ctx.beginPath();
        // Horizontal arms
        ctx.moveTo(this.x - ext, this.y); ctx.lineTo(this.x - gap, this.y);
        ctx.moveTo(this.x + gap, this.y); ctx.lineTo(this.x + ext, this.y);
        // Vertical arms
        ctx.moveTo(this.x, this.y - ext); ctx.lineTo(this.x, this.y - gap);
        ctx.moveTo(this.x, this.y + gap); ctx.lineTo(this.x, this.y + ext);
        ctx.stroke();

        // 7. Corner optic brackets (optical calibration aesthetic)
        const bDist = this.radius * 0.72;
        const bLen = 8;
        ctx.lineWidth = 1.5;
        // Top-left
        ctx.beginPath();
        ctx.moveTo(this.x - bDist, this.y - bDist + bLen);
        ctx.lineTo(this.x - bDist, this.y - bDist);
        ctx.lineTo(this.x - bDist + bLen, this.y - bDist);
        // Top-right
        ctx.moveTo(this.x + bDist - bLen, this.y - bDist);
        ctx.lineTo(this.x + bDist, this.y - bDist);
        ctx.lineTo(this.x + bDist, this.y - bDist + bLen);
        // Bottom-left
        ctx.moveTo(this.x - bDist, this.y + bDist - bLen);
        ctx.lineTo(this.x - bDist, this.y + bDist);
        ctx.lineTo(this.x - bDist + bLen, this.y + bDist);
        // Bottom-right
        ctx.moveTo(this.x + bDist - bLen, this.y + bDist);
        ctx.lineTo(this.x + bDist, this.y + bDist);
        ctx.lineTo(this.x + bDist, this.y + bDist - bLen);
        ctx.stroke();

        ctx.restore();
      }
    }

    class Shockwave {
      constructor(x, y, color) {
        this.x = x;
        this.y = y;
        this.radius = 12;
        this.alpha = 1;
        this.color = color;
      }

      update() {
        this.radius += 4;
        this.alpha -= 0.04;
      }

      draw(ctx) {
        ctx.save();
        ctx.globalAlpha = Math.max(0, this.alpha);
        ctx.strokeStyle = this.color;
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      }
    }

    class ScorePop {
      constructor(x, y, text, color) {
        this.x = x;
        this.y = y;
        this.text = text;
        this.color = color;
        this.alpha = 1;
      }

      update() {
        this.y -= 1.6;
        this.alpha -= 0.035;
      }

      draw(ctx) {
        ctx.save();
        ctx.globalAlpha = Math.max(0, this.alpha);
        ctx.fillStyle = this.color;
        ctx.font = 'bold 13px "SF Mono", Consolas, monospace';
        ctx.textAlign = 'center';
        ctx.fillText(this.text, this.x, this.y);
        ctx.restore();
      }
    }

    function initTargetScreen() {
      targetCanvas = document.getElementById('bubble-canvas');
      targetCtx = targetCanvas.getContext('2d');
      resizeCanvas(targetCanvas);

      targets = [];
      shockwaves = [];
      scorePops = [];
      targetsHit = 0;
      updateTargetUI();

      // Immediately populate 3 targets across screen so it is never empty on entry
      const h = targetCanvas.height;
      spawnTarget(h * 0.70);
      spawnTarget(h * 0.48);
      spawnTarget(h * 0.26);

      lastSpawn = performance.now();

      if (targetAnimFrame) cancelAnimationFrame(targetAnimFrame);
      animateTargets();
    }

    function spawnTarget(startY = null) {
      if (targets.length < 5 && targetsHit + targets.length < TOTAL_TARGETS + 4) {
        targets.push(new TargetObject(targetCanvas.width, targetCanvas.height, startY));
      }
    }

    function animateTargets() {
      targetCtx.clearRect(0, 0, targetCanvas.width, targetCanvas.height);

      if (performance.now() - lastSpawn > 850) {
        spawnTarget();
        lastSpawn = performance.now();
      }

      const w = targetCanvas.width;
      for (let i = targets.length - 1; i >= 0; i--) {
        const t = targets[i];
        t.update(w);
        t.draw(targetCtx);
        if (t.y < -t.radius * 2) targets.splice(i, 1);
      }

      for (let i = shockwaves.length - 1; i >= 0; i--) {
        const s = shockwaves[i];
        s.update();
        s.draw(targetCtx);
        if (s.alpha <= 0) shockwaves.splice(i, 1);
      }

      for (let i = scorePops.length - 1; i >= 0; i--) {
        const sp = scorePops[i];
        sp.update();
        sp.draw(targetCtx);
        if (sp.alpha <= 0) scorePops.splice(i, 1);
      }

      targetAnimFrame = requestAnimationFrame(animateTargets);
    }

    function popFirstTarget() {
      if (targets.length > 0) popTarget(targets[0], 0);
    }

    function popTarget(t, index) {
      sound.playPing(1200, 0.07);
      const lat = Math.round(performance.now() - t.spawnTime);
      STATE.avgLatencyMs = Math.min(Math.max(lat, 8), 45);
      document.getElementById('targets-hud-lat').innerText = `${STATE.avgLatencyMs} ms`;

      shockwaves.push(new Shockwave(t.x, t.y, t.color));
      scorePops.push(new ScorePop(t.x, t.y - t.radius, `${lat} ms`, t.color));
      targets.splice(index, 1);
      targetsHit++;
      STATE.targetsHitCount = targetsHit;
      updateTargetUI();

      if (targetsHit >= TOTAL_TARGETS) {
        sound.playFanfare();
        STATE.results.bubbles = { status: 'pass', detail: `${TOTAL_TARGETS}/${TOTAL_TARGETS} célpont (${STATE.avgLatencyMs} ms késleltetés)` };
        setTimeout(() => {
          advanceGuided();
        }, 600);
      }
    }

    function hitTargetAt(clientX, clientY) {
      const rect = targetCanvas.getBoundingClientRect();
      const x = clientX - rect.left;
      const y = clientY - rect.top;

      for (let i = targets.length - 1; i >= 0; i--) {
        const t = targets[i];
        const dist = Math.hypot(t.x - x, t.y - y);
        if (dist <= t.radius + 20) {
          popTarget(t, i);
          break;
        }
      }
    }

    function updateTargetUI() {
      document.getElementById('targets-hud-count').innerText = `${targetsHit}/${TOTAL_TARGETS}`;
    }

    document.getElementById('bubble-canvas').addEventListener('pointerdown', (e) => {
      hitTargetAt(e.clientX, e.clientY);
    });

    document.getElementById('btn-targets-reset-hud').addEventListener('click', (e) => {
      e.stopPropagation();
      sound.playClick();
      initTargetScreen();
    });

    document.getElementById('btn-targets-done-hud').addEventListener('click', (e) => {
      e.stopPropagation();
      sound.playClick();
      advanceGuided();
    });

    /* ========================================================================
       13. MODULE 5: GEOMETRY & CONVERGENCE (HUMAN EVALUATION)
       ======================================================================== */
    let geomCanvas, geomCtx;
    let geomMode = 0;

    function initGeometryScreen() {
      geomCanvas = document.getElementById('geometry-canvas');
      geomCtx = geomCanvas.getContext('2d');
      resizeCanvas(geomCanvas);
      document.getElementById('eval-geometry').classList.remove('active');
      drawGeometry();
    }

    function drawGeometry() {
      const w = geomCanvas.width;
      const h = geomCanvas.height;

      geomCtx.fillStyle = '#000000';
      geomCtx.fillRect(0, 0, w, h);

      if (geomMode === 0) {
        geomCtx.strokeStyle = '#223045';
        geomCtx.lineWidth = 1;

        for (let x = 0; x < w; x += 60) {
          geomCtx.beginPath();
          geomCtx.moveTo(x, 0); geomCtx.lineTo(x, h);
          geomCtx.stroke();
        }
        for (let y = 0; y < h; y += 60) {
          geomCtx.beginPath();
          geomCtx.moveTo(0, y); geomCtx.lineTo(w, y);
          geomCtx.stroke();
        }

        const cx = w / 2;
        const cy = h / 2;
        const maxR = Math.min(w, h) * 0.46;

        geomCtx.strokeStyle = '#16a34a';
        geomCtx.lineWidth = 1.5;
        for (let r = 50; r <= maxR; r += 50) {
          geomCtx.beginPath();
          geomCtx.arc(cx, cy, r, 0, Math.PI * 2);
          geomCtx.stroke();
        }

        const cornerR = 70;
        [[cornerR, cornerR], [w - cornerR, cornerR], [cornerR, h - cornerR], [w - cornerR, h - cornerR]].forEach(([x, y]) => {
          geomCtx.strokeStyle = '#0076ce';
          geomCtx.beginPath();
          geomCtx.arc(x, y, 50, 0, Math.PI * 2);
          geomCtx.stroke();
          geomCtx.beginPath();
          geomCtx.moveTo(x - 60, y); geomCtx.lineTo(x + 60, y);
          geomCtx.moveTo(x, y - 60); geomCtx.lineTo(x, y + 60);
          geomCtx.stroke();
        });

        geomCtx.fillStyle = '#ffffff';
        geomCtx.font = '12px "SF Mono", Consolas, monospace';
        geomCtx.textAlign = 'center';
        geomCtx.fillText('DELL HARDWARE CALIBRATION GRID // NO OPTICAL DISTORTION DETECTED', cx, cy - maxR - 20);
      } else {
        geomCtx.fillStyle = '#ffffff';
        geomCtx.font = '700 16px var(--font-sans)';
        geomCtx.textAlign = 'center';
        geomCtx.fillText('SZÖVEGÉLESSÉG ÉS OPTIKAI KONTRASZT LÉPCSŐ', w / 2, 50);

        const sizes = [9, 11, 13, 16, 20, 26, 32];
        let yPos = 100;
        sizes.forEach(sz => {
          geomCtx.font = `${sz}px var(--font-sans)`;
          geomCtx.fillStyle = '#ffffff';
          geomCtx.fillText(`Dell OptiPlex All-in-One Touch Display System - ${sz}px éles betűkészlet`, w / 2, yPos);
          yPos += sz + 16;
        });

        const bW = 340;
        const bH = 150;
        const startX = w / 2 - bW / 2;
        const startY = yPos + 25;

        geomCtx.fillStyle = '#000000';
        geomCtx.fillRect(startX, startY, bW, bH);
        geomCtx.strokeStyle = '#ffffff';
        geomCtx.lineWidth = 1;

        for (let y = startY; y < startY + bH; y += 2) {
          geomCtx.beginPath();
          geomCtx.moveTo(startX, y); geomCtx.lineTo(startX + bW, y);
          geomCtx.stroke();
        }

        geomCtx.font = '11px "SF Mono", Consolas, monospace';
        geomCtx.fillStyle = '#94a3b8';
        geomCtx.fillText('1-képpontos váltakozó horizontális fésűminta', w / 2, startY + bH + 20);
      }
    }

    function showGeometryEvaluation() {
      document.getElementById('eval-geometry').classList.add('active');
    }

    document.getElementById('btn-geom-toggle-hud').addEventListener('click', (e) => {
      e.stopPropagation();
      sound.playClick();
      geomMode = geomMode === 0 ? 1 : 0;
      drawGeometry();
    });

    document.getElementById('btn-geom-done-hud').addEventListener('click', (e) => {
      e.stopPropagation();
      sound.playClick();
      showGeometryEvaluation();
    });

    document.getElementById('btn-eval-geom-pass').addEventListener('click', () => {
      sound.playClick();
      STATE.results.geometry = { status: 'pass', detail: 'Szabályos geometriai körök, éles betűk' };
      document.getElementById('eval-geometry').classList.remove('active');
      advanceGuided();
    });

    document.getElementById('btn-eval-geom-fail').addEventListener('click', () => {
      sound.playClick();
      STATE.results.geometry = { status: 'fail', detail: 'Optikai torzulás vagy homályosság jelezve' };
      document.getElementById('eval-geometry').classList.remove('active');
      advanceGuided();
    });

    /* ========================================================================
       14. MODULE 6: INSPECTION REPORT (TRUTHFUL AUDIT SHEET)
       ======================================================================== */
    function initCertificateScreen() {
      document.body.classList.remove('test-running');
      sound.playFanfare();

      const now = new Date();
      const dateStr = `${now.getFullYear()}.${String(now.getMonth()+1).padStart(2,'0')}.${String(now.getDate()).padStart(2,'0')} • Nyílt Nap`;
      document.getElementById('rep-date-val').innerText = dateStr;

      // 1. Pixel test
      const resPixel = STATE.results.pixel;
      const elPixel = document.getElementById('rep-pixel-status');
      const elPixelMeas = document.getElementById('rep-pixel-meas');
      elPixelMeas.innerText = resPixel.detail || 'Alapszínek & Minták';
      if (resPixel.status === 'pass') {
        elPixel.innerText = 'PASS [MEGFELELT]';
        elPixel.className = 'pass-status';
      } else if (resPixel.status === 'fail') {
        elPixel.innerText = 'FAIL [HIBA JELÖLVE]';
        elPixel.className = 'fail-status';
      } else {
        elPixel.innerText = 'NEM VIZSGÁLT';
        elPixel.className = 'warn-status';
      }

      // 2. Grid test
      const resGrid = STATE.results.grid;
      const elGrid = document.getElementById('rep-cov-status');
      const elGridMeas = document.getElementById('rep-cov-meas');
      elGridMeas.innerText = resGrid.detail || `${STATE.gridCoveredPercent}% lefedettség`;
      if (resGrid.status === 'pass') {
        elGrid.innerText = 'PASS [MEGFELELT]';
        elGrid.className = 'pass-status';
      } else if (resGrid.status === 'fail') {
        elGrid.innerText = 'FAIL [NEM MEGFELELT]';
        elGrid.className = 'fail-status';
      } else {
        elGrid.innerText = 'NEM VIZSGÁLT';
        elGrid.className = 'warn-status';
      }

      // 3. Multi-touch test
      const resMt = STATE.results.multitouch;
      const elMt = document.getElementById('rep-touch-status');
      const elMtMeas = document.getElementById('rep-touch-meas');
      elMtMeas.innerText = resMt.detail || `${STATE.maxTouchDetected} pont érzékelve`;
      if (resMt.status === 'pass') {
        elMt.innerText = 'PASS [MEGFELELT]';
        elMt.className = 'pass-status';
      } else if (resMt.status === 'fail') {
        elMt.innerText = 'FAIL [NEM MEGFELELT]';
        elMt.className = 'fail-status';
      } else {
        elMt.innerText = 'NEM VIZSGÁLT';
        elMt.className = 'warn-status';
      }

      // 4. Target / Latency test
      const resBubbles = STATE.results.bubbles;
      const elBubbles = document.getElementById('rep-lat-status');
      const elBubblesMeas = document.getElementById('rep-lat-meas');
      elBubblesMeas.innerText = resBubbles.detail || `${STATE.avgLatencyMs} ms késleltetés`;
      if (resBubbles.status === 'pass') {
        elBubbles.innerText = 'PASS [OPTIMÁLIS]';
        elBubbles.className = 'pass-status';
      } else if (resBubbles.status === 'fail') {
        elBubbles.innerText = 'FAIL [BEFEJEZETLEN]';
        elBubbles.className = 'fail-status';
      } else {
        elBubbles.innerText = 'NEM VIZSGÁLT';
        elBubbles.className = 'warn-status';
      }

      // 5. Geometry test
      const resGeom = STATE.results.geometry;
      const elGeom = document.getElementById('rep-geom-status');
      const elGeomMeas = document.getElementById('rep-geom-meas');
      elGeomMeas.innerText = resGeom.detail || 'Optikai körök & szubpixel';
      if (resGeom.status === 'pass') {
        elGeom.innerText = 'PASS [MEGFELELT]';
        elGeom.className = 'pass-status';
      } else if (resGeom.status === 'fail') {
        elGeom.innerText = 'FAIL [HIBA JELÖLVE]';
        elGeom.className = 'fail-status';
      } else {
        elGeom.innerText = 'NEM VIZSGÁLT';
        elGeom.className = 'warn-status';
      }

      // Master stamp calculation
      const stamp = document.getElementById('report-main-stamp');
      const summaryText = document.getElementById('rep-summary-text');
      const allResults = [resPixel, resGrid, resMt, resBubbles, resGeom];

      const anyFail = allResults.some(r => r.status === 'fail');
      const anyPending = allResults.some(r => r.status === 'pending' || r.status === 'skipped');
      const allPass = allResults.every(r => r.status === 'pass');

      if (allPass) {
        stamp.innerText = 'VERIFIED PASS';
        stamp.className = 'report-stamp';
        summaryText.innerText = 'Minden tesztmodul sikeresen teljesítve (Pass)';
      } else if (anyFail) {
        stamp.innerText = 'FAIL / HIBA';
        stamp.className = 'report-stamp fault';
        summaryText.innerText = 'Egy vagy több modulnál hiba lett regisztrálva';
      } else if (anyPending) {
        stamp.innerText = 'BEFEJEZETLEN';
        stamp.className = 'report-stamp warn';
        summaryText.innerText = 'Néhány tesztmodul nem lett teljes körűen befejezve';
      }
    }

    document.getElementById('btn-finish-report').addEventListener('click', () => {
      sound.playClick();
      resetQCState();
      goHome();
    });

    /* ========================================================================
       15. BOOTSTRAP ON LOAD
       ======================================================================== */
    window.addEventListener('DOMContentLoaded', () => {
      detectSpecs();
      resetQCState();
      showScreen('screen-welcome');
      resetWatchdog();
    });
  </script>
