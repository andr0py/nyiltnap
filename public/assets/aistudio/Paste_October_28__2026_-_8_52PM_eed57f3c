    /* ========================================================================
       6. INACTIVITY WATCHDOG & SCREEN SAVER (PANEL BURN-IN PROTECTION)
       ======================================================================== */
    let idleTimeout = null;
    let idleInterval = null;
    const IDLE_LIMIT = 120; // 2 minutes (120 seconds) inactivity
    const IDLE_COUNTDOWN = 60; // 60 seconds countdown
    let countdownVal = IDLE_COUNTDOWN;

    let ssCanvas = null;
    let ssCtx = null;
    let ssAnimFrame = null;
    let isScreensaverActive = false;

    // Screensaver bouncing diagnostic widget state
    const ssBox = {
      x: 100,
      y: 100,
      w: 480,
      h: 180,
      vx: 1.3,
      vy: 0.95
    };
    let ssParticles = [];

    function drawRoundRect(ctx, x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.lineTo(x + w - r, y);
      ctx.arcTo(x + w, y, x + w, y + r, r);
      ctx.lineTo(x + w, y + h - r);
      ctx.arcTo(x + w, y + h, x + w - r, y + h, r);
      ctx.lineTo(x + r, y + h);
      ctx.arcTo(x, y + h, x, y + h - r, r);
      ctx.lineTo(x, y + r);
      ctx.arcTo(x, y, x + r, y, r);
      ctx.closePath();
    }

    function initScreensaverCanvas() {
      if (!ssCanvas) {
        ssCanvas = document.getElementById('screensaver-canvas');
        ssCtx = ssCanvas.getContext('2d');
      }
      ssCanvas.width = window.innerWidth;
      ssCanvas.height = window.innerHeight;

      // Seed subtle ambient pixel-exercising particles to refresh matrix
      ssParticles = [];
      const count = 40;
      for (let i = 0; i < count; i++) {
        ssParticles.push({
          x: Math.random() * ssCanvas.width,
          y: Math.random() * ssCanvas.height,
          vx: (Math.random() - 0.5) * 0.7,
          vy: (Math.random() - 0.5) * 0.7,
          radius: 1.5 + Math.random() * 2,
          alpha: 0.15 + Math.random() * 0.35,
          color: trackerColors[Math.floor(Math.random() * trackerColors.length)]
        });
      }

      ssBox.w = Math.min(500, ssCanvas.width - 60);
      ssBox.h = 190;
      ssBox.x = (ssCanvas.width - ssBox.w) / 2;
      ssBox.y = (ssCanvas.height - ssBox.h) / 2;
      ssBox.vx = 1.3;
      ssBox.vy = 0.95;
    }

    function showScreensaver() {
      if (isScreensaverActive) return;
      isScreensaverActive = true;
      const overlay = document.getElementById('screensaver-overlay');
      overlay.classList.add('active');
      initScreensaverCanvas();

      if (ssAnimFrame) cancelAnimationFrame(ssAnimFrame);
      animateScreensaver();
    }

    function hideScreensaver() {
      if (!isScreensaverActive) return;
      isScreensaverActive = false;
      const overlay = document.getElementById('screensaver-overlay');
      if (overlay) overlay.classList.remove('active');
      if (ssAnimFrame) {
        cancelAnimationFrame(ssAnimFrame);
        ssAnimFrame = null;
      }
      sound.playClick();
    }

    function animateScreensaver() {
      if (!isScreensaverActive) return;

      const w = ssCanvas.width;
      const h = ssCanvas.height;

      // 1. Deep OLED-friendly pitch black background (protects pixels from burn-in)
      ssCtx.fillStyle = '#000000';
      ssCtx.fillRect(0, 0, w, h);

      // 2. Faint ambient moving particles to gently refresh subpixel matrix
      for (let i = 0; i < ssParticles.length; i++) {
        const p = ssParticles[i];
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = w;
        if (p.x > w) p.x = 0;
        if (p.y < 0) p.y = h;
        if (p.y > h) p.y = 0;

        ssCtx.save();
        ssCtx.globalAlpha = p.alpha;
        ssCtx.fillStyle = p.color;
        ssCtx.beginPath();
        ssCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ssCtx.fill();
        ssCtx.restore();
      }

      // 3. Move floating badge across screen and bounce smoothly off edges
      ssBox.x += ssBox.vx;
      ssBox.y += ssBox.vy;

      if (ssBox.x <= 20) {
        ssBox.x = 20;
        ssBox.vx = Math.abs(ssBox.vx);
      } else if (ssBox.x + ssBox.w >= w - 20) {
        ssBox.x = w - 20 - ssBox.w;
        ssBox.vx = -Math.abs(ssBox.vx);
      }

      if (ssBox.y <= 20) {
        ssBox.y = 20;
        ssBox.vy = Math.abs(ssBox.vy);
      } else if (ssBox.y + ssBox.h >= h - 20) {
        ssBox.y = h - 20 - ssBox.h;
        ssBox.vy = -Math.abs(ssBox.vy);
      }

      // 4. Draw floating badge container
      ssCtx.save();
      ssCtx.fillStyle = 'rgba(15, 23, 42, 0.90)';
      drawRoundRect(ssCtx, ssBox.x, ssBox.y, ssBox.w, ssBox.h, 8);
      ssCtx.fill();

      // Glowing Dell blue border
      ssCtx.strokeStyle = '#0076ce';
      ssCtx.lineWidth = 2;
      ssCtx.stroke();

      // Top line accent
      ssCtx.fillStyle = '#0076ce';
      drawRoundRect(ssCtx, ssBox.x, ssBox.y, ssBox.w, 4, 2);
      ssCtx.fill();

      // Badge content text
      ssCtx.fillStyle = '#94a3b8';
      ssCtx.font = '700 11px "SF Mono", Consolas, monospace';
      ssCtx.textAlign = 'left';
      ssCtx.fillText('DELL HARDWARE DIAGNOSTICS // NYÍLT NAP', ssBox.x + 24, ssBox.y + 36);

      ssCtx.fillStyle = '#ffffff';
      ssCtx.font = '800 20px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      ssCtx.fillText('Érintőképernyő és Kijelző Teszt', ssBox.x + 24, ssBox.y + 70);

      // Pulsing invitation text
      const pulse = 0.65 + Math.sin(performance.now() * 0.0035) * 0.35;
      ssCtx.fillStyle = `rgba(0, 118, 206, ${pulse})`;
      ssCtx.font = '700 14px "SF Mono", Consolas, monospace';
      ssCtx.fillText('> ÉRINTSD MEG A KÉPERNYŐT A KEZDÉSHEZ <', ssBox.x + 24, ssBox.y + 115);

      // Subtitle status
      ssCtx.fillStyle = '#64748b';
      ssCtx.font = '10px "SF Mono", Consolas, monospace';
      ssCtx.fillText('Panelvédő üzemmód aktív • Digitizer készenlétben', ssBox.x + 24, ssBox.y + 152);

      // Animated optic reticle in top-right of badge
      const cx = ssBox.x + ssBox.w - 44;
      const cy = ssBox.y + 44;
      ssCtx.strokeStyle = '#0076ce';
      ssCtx.lineWidth = 1.5;
      ssCtx.beginPath();
      ssCtx.arc(cx, cy, 14, 0, Math.PI * 2);
      ssCtx.stroke();

      ssCtx.beginPath();
      ssCtx.arc(cx, cy, 3, 0, Math.PI * 2);
      ssCtx.fillStyle = '#0076ce';
      ssCtx.fill();

      const rot = (performance.now() * 0.001) % (Math.PI * 2);
      ssCtx.beginPath();
      ssCtx.moveTo(cx + Math.cos(rot) * 18, cy + Math.sin(rot) * 18);
      ssCtx.lineTo(cx - Math.cos(rot) * 18, cy - Math.sin(rot) * 18);
      ssCtx.moveTo(cx + Math.cos(rot + Math.PI/2) * 18, cy + Math.sin(rot + Math.PI/2) * 18);
      ssCtx.lineTo(cx - Math.cos(rot + Math.PI/2) * 18, cy - Math.sin(rot + Math.PI/2) * 18);
      ssCtx.stroke();

      ssCtx.restore();

      ssAnimFrame = requestAnimationFrame(animateScreensaver);
    }

    function resetWatchdog() {
      // 1. Wake up from screensaver if active
      if (isScreensaverActive) {
        hideScreensaver();
      }

      // 2. Hide countdown modal if active
      hideIdleAlert();

      // 3. Clear existing timers
      if (idleTimeout) {
        clearTimeout(idleTimeout);
        idleTimeout = null;
      }

      // 4. Schedule new timer based on current screen
      if (STATE.currentScreen === 'screen-welcome') {
        // On welcome screen: activate screensaver after 2 minutes
        idleTimeout = setTimeout(() => {
          showScreensaver();
        }, IDLE_LIMIT * 1000);
      } else {
        // Inside test / report: start 60s countdown after 2 minutes
        idleTimeout = setTimeout(() => {
          showIdleAlert();
        }, IDLE_LIMIT * 1000);
      }
    }

    function showIdleAlert() {
      countdownVal = IDLE_COUNTDOWN;
      const countEl = document.getElementById('idle-countdown-num');
      countEl.innerText = countdownVal;
      document.getElementById('modal-idle').classList.add('active');

      if (idleInterval) clearInterval(idleInterval);
      idleInterval = setInterval(() => {
        countdownVal--;
        countEl.innerText = countdownVal;
        if (countdownVal <= 0) {
          clearInterval(idleInterval);
          idleInterval = null;
          hideIdleAlert();
          resetQCState();
          goHome();
        }
      }, 1000);
    }

    function hideIdleAlert() {
      if (idleInterval) {
        clearInterval(idleInterval);
        idleInterval = null;
      }
      const modal = document.getElementById('modal-idle');
      if (modal) modal.classList.remove('active');
    }

    // Érintéses felébresztés - modal és képernyővédő
    document.getElementById('modal-idle').addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      sound.playClick();
      resetWatchdog();
    });

    document.getElementById('btn-idle-resume').addEventListener('click', (e) => {
      e.stopPropagation();
      sound.playClick();
      resetWatchdog();
    });

    document.getElementById('screensaver-overlay').addEventListener('pointerdown', (e) => {
      e.preventDefault();
      e.stopPropagation();
      resetWatchdog();
    });

    // Global interaction listeners with jitter-resistant mousemove
    let lastMouseX = null;
    let lastMouseY = null;

    ['pointerdown', 'touchstart', 'keydown'].forEach(evt => {
      window.addEventListener(evt, () => resetWatchdog(), { passive: true });
    });

    window.addEventListener('mousemove', (e) => {
      if (lastMouseX === null) {
        lastMouseX = e.clientX;
        lastMouseY = e.clientY;
        return;
      }
      const dist = Math.hypot(e.clientX - lastMouseX, e.clientY - lastMouseY);
      if (dist > 15) {
        lastMouseX = e.clientX;
        lastMouseY = e.clientY;
        resetWatchdog();
      }
