    function detectSpecs() {
      const w = window.screen.width;
      const h = window.screen.height;
      const dpr = window.devicePixelRatio || 1;
      const touchPoints = navigator.maxTouchPoints || 0;

      document.getElementById('nav-display-res').innerText = `${w}x${h}`;
      document.getElementById('hw-res-val').innerText = `${w} × ${h} (${Math.round(w*dpr)}×${Math.round(h*dpr)})`;

      const touchText = touchPoints > 0 ? `${touchPoints} pontos kapacitív digitizer` : 'Érintőképernyő üzemmód';
      document.getElementById('hw-touch-val').innerText = touchText;

      let count = 0;
      let start = performance.now();
      function measureFps(t) {
        count++;
        if (t - start >= 500) {
          const fps = Math.round((count * 1000) / (t - start));
          document.getElementById('hw-fps-val').innerText = `${fps} Hz`;
        } else {
          requestAnimationFrame(measureFps);
        }
      }
      requestAnimationFrame(measureFps);
    }

